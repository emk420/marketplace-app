rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidItem(data) {
      return data.title is string && data.title.size() <= 150
        && data.brand is string && data.brand.size() <= 100
        && data.listingPrice is number && data.listingPrice > 0
        && data.sellerId is string && data.sellerId.size() <= 128;
    }

    function isValidOrder(data) {
      return data.orderNumber is string && data.orderNumber.size() <= 100
        && data.itemId is string && data.itemId.size() <= 128
        && data.itemPrice is number && data.itemPrice > 0
        && data.buyerId is string && data.buyerId.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && data.status is string && data.status.size() <= 100
        && data.trackingNumber is string && data.trackingNumber.size() <= 100;
    }

    function isValidOffer(data) {
      return data.itemId is string && data.itemId.size() <= 128
        && data.offeredPrice is number && data.offeredPrice > 0
        && data.buyerId is string && data.buyerId.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && data.status is string && data.status.size() <= 50;
    }

    function isValidProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 150;
    }

    // 1. Marketplace Items (Public Catalog)
    match /items/{itemId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(itemId)
        && incoming().sellerId == request.auth.uid
        && isValidItem(incoming());

      allow update: if isSignedIn() && (
        // Seller updating own item: preserve sellerId
        (existing().sellerId == request.auth.uid && incoming().sellerId == existing().sellerId && isValidItem(incoming())) ||
        // Public interactions (like / share increment)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'shares']))
      );

      allow delete: if isSignedIn() && existing().sellerId == request.auth.uid;
    }

    // 2. Orders (Escrow & Shipping)
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidId(orderId)
        && incoming().buyerId == request.auth.uid
        && isValidOrder(incoming());

      allow update: if isSignedIn()
        && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && isValidOrder(incoming());

      allow delete: if false;
    }

    // 3. Offers (Price Negotiations)
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidId(offerId)
        && incoming().buyerId == request.auth.uid
        && isValidOffer(incoming());

      allow update: if isSignedIn()
        && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid)
        && incoming().buyerId == existing().buyerId
        && incoming().sellerId == existing().sellerId
        && isValidOffer(incoming());

      allow delete: if false;
    }

    // 4. Private User Profiles & Accounts (PII Isolation)
    match /users/{userId}/profile/info {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(userId) && isValidProfile(incoming());
    }

    // 5. Connection Test Collection (Used on boot)
    match /test/{docId} {
      allow read: if true;
    }
  }
}
